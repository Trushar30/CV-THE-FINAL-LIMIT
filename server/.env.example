# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database & Storage
MONGODB_URI=mongodb://localhost:27017/corpverse

# Authentication Secrets (Generate strong random secrets in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# AI Providers API Keys & Key Vault (Server-side only)
AI_KEY_VAULT_SECRET=your_ai_key_vault_secret_min_32_chars_long
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# AI Gateway Defaults
AI_PROVIDER_PRIORITY=gemini,openai,groq
AI_MAX_RETRIES_PER_PROVIDER=3
AI_TIMEOUT_MS=30000

# Email Verification & Notifications
EMAIL_SERVICE_TYPE=console
EMAIL_FROM="CorpVerse <noreply@corpverse.com>"
APP_URL=http://localhost:5173
# SMTP Settings (Required only when EMAIL_SERVICE_TYPE=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=your_smtp_password

