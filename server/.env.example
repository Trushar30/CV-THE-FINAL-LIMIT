# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database & Storage
MONGODB_URI=mongodb://localhost:27017/corpverse

# Authentication Secrets (Generate strong random secrets in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# AI Providers API Keys (Server-side only)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROK_API_KEY=your_grok_api_key_here

# AI Gateway Defaults
AI_PROVIDER_PRIORITY=gemini,openai,grok
AI_MAX_RETRIES_PER_PROVIDER=3
AI_TIMEOUT_MS=30000
